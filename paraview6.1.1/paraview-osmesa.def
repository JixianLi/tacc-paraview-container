# ParaView 6.1.1 with OSMesa (software) rendering and the TTK (Topology
# ToolKit) plugin, linked against uv-managed Python 3.13. Runs on any partition
# (CPU-only or GPU); slower than the EGL build on a GPU node but doesn't need
# --nv.
#
# The build logic lives in build-common.sh, shared with paraview-egl.def. This
# file just sets BACKEND=osmesa and lets the script select OSMesa-specific apt
# packages and VTK cmake flags. Bump versions / change shared build steps in
# build-common.sh.
#
# Build (on Lonestar, in an idev session for the CPU budget):
#     idev -p development -N 1 -n 128 -t 01:00:00
#     cd /path/to/repo/paraview6.1.1   # so apptainer can resolve build-common.sh
#     APPTAINER_CACHEDIR=$SCRATCH/.apptainer_cache \
#         apptainer build --fakeroot $WORK/paraview-6.1.1-osmesa.sif paraview-osmesa.def
#
# Or use install.sh, which handles the cwd:
#     /path/to/repo/paraview6.1.1/install.sh --backend osmesa
#
# Run on any partition (no GPU passthrough needed):
#     apptainer exec paraview-6.1.1-osmesa.sif pvbatch your_script.py
#
# Note: the build needs outbound HTTPS (apt, git, astral.sh, gitlab.kitware.com).

Bootstrap: docker
From: ubuntu:24.04

%labels
    ParaView v6.1.1
    Rendering OSMesa (software)
    Python 3.13 (uv-managed)

%files
    build-common.sh /tmp/build-common.sh

%environment
    export PARAVIEW_PREFIX=/opt/paraview
    export PATH=/opt/paraview/bin:/usr/local/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/paraview/lib:${LD_LIBRARY_PATH:-}

%post
    export BACKEND=osmesa
    bash /tmp/build-common.sh
    rm /tmp/build-common.sh

%runscript
    exec /bin/bash "$@"
