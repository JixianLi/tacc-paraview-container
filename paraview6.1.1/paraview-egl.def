# ParaView 6.1.1 with EGL rendering and the TTK (Topology ToolKit) plugin,
# linked against uv-managed Python 3.13. Intended to be built directly on TACC
# Lonestar6 with apptainer --fakeroot.
#
# The build logic lives in build-common.sh, shared with paraview-osmesa.def.
# This file just sets BACKEND=egl and lets the script select EGL-specific apt
# packages and VTK cmake flags. Bump versions / change shared build steps in
# build-common.sh.
#
# Build (on Lonestar, in an idev session for the CPU budget):
#     idev -p development -N 1 -n 128 -t 01:00:00
#     cd /path/to/repo/paraview6.1.1   # so apptainer can resolve build-common.sh
#     APPTAINER_CACHEDIR=$SCRATCH/.apptainer_cache \
#         apptainer build --fakeroot $WORK/paraview-6.1.1-egl.sif paraview-egl.def
#
# Or use install.sh, which handles the cwd:
#     /path/to/repo/paraview6.1.1/install.sh --backend egl
#
# Run on a GPU partition (--nv passes through the NVIDIA driver):
#     apptainer exec --nv paraview-6.1.1-egl.sif pvbatch your_script.py
#
# Note: the build needs outbound HTTPS (apt, git, astral.sh, gitlab.kitware.com).
# If a compute node blocks egress, build from a login node instead, but watch
# the per-process CPU-time limit there.

Bootstrap: docker
From: ubuntu:24.04

%labels
    ParaView v6.1.1
    Rendering EGL
    Python 3.13 (uv-managed)

%files
    build-common.sh /tmp/build-common.sh

%environment
    export PARAVIEW_PREFIX=/opt/paraview
    export PATH=/opt/paraview/bin:/usr/local/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/paraview/lib:${LD_LIBRARY_PATH:-}

%post
    export BACKEND=egl
    bash /tmp/build-common.sh
    rm /tmp/build-common.sh

%runscript
    exec /bin/bash "$@"
